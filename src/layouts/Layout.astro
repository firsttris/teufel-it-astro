---
import "@fontsource-variable/inter";
import "../styles/global.css";
import HeroBackground3D from "../components/HeroBackground3D.astro";
import Footer from "../components/Footer.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { languages, localizedPath, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  /** Path below the language prefix, e.g. "/" or "/impressum/". */
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, path = "/", title, description, noindex = false } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} – Tristan Teufel` : t("meta.title");
const pageDescription = description ?? t("meta.description");
const canonical = new URL(localizedPath(lang, path), Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05070f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical} />
    {
      languages.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localizedPath(l, path), Astro.site).href} />
      ))
    }
    {path === "/" && <link rel="alternate" hreflang="x-default" href={Astro.site} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tristan Teufel" />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-background text-white antialiased selection:bg-blue-500 selection:text-white">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <HeroBackground3D />
    </div>
    <div class="relative z-10 flex min-h-screen flex-col">
      <LanguageSwitch lang={lang} path={path} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>

<style is:global>
  /* Reveal Animation Classes */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: reveal 0.8s ease forwards;
  }

  .reveal-delay-1 {
    animation-delay: 0.1s;
  }
  .reveal-delay-2 {
    animation-delay: 0.2s;
  }
  .reveal-delay-3 {
    animation-delay: 0.3s;
  }
  .reveal-delay-4 {
    animation-delay: 0.4s;
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
