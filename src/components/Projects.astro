---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import haben from "../assets/projects/haben.png";
import kontext from "../assets/projects/kontext.png";
import schreibzeug from "../assets/projects/schreibzeug.png";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

const projects = [
  {
    name: "Haben",
    image: haben,
    alt: t("projects.haben.alt"),
    tagline: t("projects.haben.tagline"),
    desc: t("projects.haben.desc"),
    docs: "https://firsttris.github.io/haben/",
    source: "https://github.com/firsttris/haben",
  },
  {
    name: "Kontext",
    image: kontext,
    alt: t("projects.kontext.alt"),
    tagline: t("projects.kontext.tagline"),
    desc: t("projects.kontext.desc"),
    docs: "https://firsttris.github.io/kontext/",
    source: "https://github.com/firsttris/kontext",
  },
  {
    name: "Schreibzeug",
    image: schreibzeug,
    alt: t("projects.schreibzeug.alt"),
    tagline: t("projects.schreibzeug.tagline"),
    desc: t("projects.schreibzeug.desc"),
    docs: "https://firsttris.github.io/schreibzeug/",
    source: "https://github.com/firsttris/schreibzeug",
  },
];

const linkClass = "inline-flex items-center gap-1.5 text-zinc-300 transition-colors hover:text-white";
---

<section class="relative py-24">
  <div class="container mx-auto px-6 md:px-12">
    <div class="mb-16 space-y-4 text-center">
      <h2 class="mx-auto max-w-3xl text-3xl font-bold text-white md:text-5xl">{t("projects.title")}</h2>
      <p class="mx-auto max-w-2xl text-xl text-zinc-400">{t("projects.subtitle")}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {
        projects.map((project) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-zinc-950/70 transition-colors duration-300 hover:border-white/25">
            <a href={project.docs} target="_blank" rel="noopener noreferrer" class="block border-b border-white/10">
              <Image
                src={project.image}
                alt={project.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                class="aspect-16/10 w-full object-cover object-top-left"
              />
            </a>
            <div class="flex flex-1 flex-col p-8">
              <h3 class="text-2xl font-bold text-white">{project.name}</h3>
              <p class="mt-1 text-sm font-medium text-blue-300">{project.tagline}</p>
              <p class="mt-4 flex-1 leading-relaxed text-zinc-400">{project.desc}</p>
              <div class="mt-6 flex gap-6 text-sm font-medium">
                <a href={project.docs} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  <Icon name="mdi:book-open-page-variant-outline" class="size-4" aria-hidden="true" />
                  {t("projects.docs")}
                </a>
                <a href={project.source} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
                  {t("projects.source")}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-12 text-center text-zinc-400">
      <a
        href="https://github.com/firsttris/vscode-jest-runner"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-white underline decoration-blue-500/50 transition-colors hover:decoration-blue-500"
      >vscode-jest-runner</a>: {t("projects.jestRunner")}
    </p>
  </div>
</section>
