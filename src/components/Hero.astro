---
import ProfileLink from "./ProfileLink.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

const secondary = "bg-white/5 text-white hover:bg-white/10 border-white/10";
const links = [
  {
    name: "GitHub",
    icon: "simple-icons:github",
    link: "https://github.com/firsttris",
    class: "bg-zinc-100 text-zinc-950 hover:bg-white border-transparent",
  },
  {
    name: "LinkedIn",
    icon: "simple-icons:linkedin",
    link: "https://www.linkedin.com/in/tristanteufel/",
    class: secondary,
  },
  { name: t("links.cv"), icon: "mdi:file-account", link: "https://cv.teufel-it.de", class: secondary },
  { name: t("links.email"), icon: "mdi:email", link: "mailto:info@teufel-it.de", class: secondary },
];
---

<section class="relative isolate flex min-h-screen flex-col items-center justify-center overflow-hidden py-20">
  <div class="relative z-10 container mx-auto flex flex-col items-center gap-10 px-6 text-center md:px-12">
    <h1 class="reveal max-w-5xl text-6xl leading-[1.1] font-black tracking-tight text-white md:text-8xl">
      Tristan Teufel
      <br />
      <span class="animate-gradient-text">{t("hero.role")}</span>
    </h1>

    <p class="reveal reveal-delay-2 max-w-2xl text-xl leading-relaxed font-light text-zinc-400 md:text-2xl">
      {t("hero.tagline")}
    </p>

    <div class="reveal reveal-delay-3 flex flex-wrap justify-center gap-4 pt-4">
      {links.map((link) => <ProfileLink {...link} />)}
    </div>
  </div>
</section>

<style>
  @keyframes gradientTextFlow {
    0% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-gradient-text {
    display: inline-block;
    color: transparent;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
    background-image: repeating-linear-gradient(
      90deg,
      #22d3ee 0%,
      #3b82f6 34%,
      #a855f7 50%,
      #3b82f6 66%,
      #22d3ee 100%
    );
    background-size: 200% 100%;
    background-repeat: no-repeat;
    animation: gradientTextFlow 18s ease-in-out infinite alternate;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-gradient-text {
      animation: none;
    }
  }
</style>
