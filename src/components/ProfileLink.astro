---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  link: string;
  icon: string;
  class?: string;
}

const { name, link, icon, class: className }: Props = Astro.props;
const external = link.startsWith("http");
---

<a
  href={link}
  {...external && { target: "_blank", rel: "noopener noreferrer" }}
  class:list={[
    "w-36 flex items-center justify-center gap-2 px-4 py-2 rounded-lg transition-all duration-300 group no-underline border",
    className,
  ]}
>
  <Icon name={icon} class="w-5 h-5 group-hover:text-blue-400 transition-colors" aria-hidden="true" />
  <span class="text-sm font-medium">{name}</span>
</a>
