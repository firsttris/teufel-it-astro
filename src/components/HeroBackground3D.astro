<div class="hero-3d-bg" aria-hidden="true">
  <canvas class="hero-3d-canvas"></canvas>
  <div class="hero-3d-overlay"></div>
</div>

<script>
  const vertexShader = /* glsl */ `
    attribute float aSpeed;

    uniform float uTravel;
    uniform float uDepth;
    uniform float uNear;
    uniform float uSize;
    uniform float uScale;

    varying float vFade;

    void main() {
      // Stars move along +z and wrap around, so the whole flight happens on the GPU.
      float span = uDepth + uNear;
      float z = mod(position.z + uTravel * aSpeed, span) - uDepth;

      vec4 mvPosition = modelViewMatrix * vec4(position.xy, z, 1.0);
      gl_Position = projectionMatrix * mvPosition;
      gl_PointSize = uSize * uScale / -mvPosition.z;

      // Fade stars in at the far end and out right before they pass the camera.
      vFade = smoothstep(-uDepth, -uDepth + 60.0, z) * (1.0 - smoothstep(uNear - 4.0, uNear, z));
    }
  `;

  const fragmentShader = /* glsl */ `
    uniform sampler2D uMap;
    uniform vec3 uColor;

    varying float vFade;

    void main() {
      vec4 texel = texture2D(uMap, gl_PointCoord);
      float alpha = texel.a * vFade;
      if (alpha < 0.08) discard;
      gl_FragColor = vec4(uColor * texel.rgb, alpha);
      #include <colorspace_fragment>
    }
  `;

  const planetVertexShader = /* glsl */ `
    varying vec2 vUv;

    void main() {
      vUv = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  // The planet is drawn on a camera-facing quad, so it stays perfectly round even
  // near the edge of the screen where a real sphere would be stretched by perspective.
  const planetFragmentShader = /* glsl */ `
    uniform float uExtent;
    uniform float uRotation;
    uniform vec3 uLightDirection;

    varying vec2 vUv;

    float hash(vec3 p) {
      return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
    }

    float noise(vec3 p) {
      vec3 i = floor(p);
      vec3 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
        mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y),
        f.z
      );
    }

    vec3 rotateY(vec3 p, float a) {
      float c = cos(a);
      float s = sin(a);
      return vec3(c * p.x + s * p.z, p.y, -s * p.x + c * p.z);
    }

    vec3 rotateZ(vec3 p, float a) {
      float c = cos(a);
      float s = sin(a);
      return vec3(c * p.x - s * p.y, s * p.x + c * p.y, p.z);
    }

    void main() {
      vec2 p = (vUv - 0.5) * 2.0 * uExtent;
      float r = length(p);
      vec3 light = normalize(uLightDirection);
      vec3 purple = vec3(0.66, 0.33, 0.97);
      vec3 cyan = vec3(0.13, 0.83, 0.93);

      // Thin atmosphere glow around the lit side.
      if (r > 1.0) {
        float facing = clamp(dot(normalize(p), normalize(light.xy)) * 0.5 + 0.5, 0.0, 1.0);
        float glow = exp(-(r - 1.0) * 28.0) * (0.08 + 0.5 * facing * facing);
        gl_FragColor = vec4(mix(purple, cyan, facing), glow * 0.45);
        #include <colorspace_fragment>
        return;
      }

      vec3 normal = vec3(p, sqrt(1.0 - r * r));
      vec3 q = rotateY(rotateZ(normal, -0.35), uRotation);

      // Soft gas-giant bands, distorted by noise.
      float bands = sin(q.y * 12.0 + noise(q * 2.5) * 3.0) * 0.5 + 0.5;
      bands = mix(bands, noise(q * 7.0), 0.35);
      vec3 surface = mix(vec3(0.005, 0.006, 0.016), vec3(0.03, 0.022, 0.07), bands);

      float diffuse = max(dot(normal, light), 0.0);
      float rim = pow(1.0 - normal.z, 3.0);
      vec3 rimColor = mix(purple, cyan, clamp(dot(normalize(p + 1e-4), normalize(light.xy)) * 0.5 + 0.5, 0.0, 1.0));

      vec3 color = surface * (0.06 + 0.94 * diffuse) + rimColor * rim * diffuse * 0.55;
      float edge = 1.0 - smoothstep(0.985, 1.0, r);
      gl_FragColor = vec4(color, edge);
      #include <colorspace_fragment>
    }
  `;

  const shootingStarVertexShader = /* glsl */ `
    varying vec2 vUv;

    void main() {
      vUv = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  const shootingStarFragmentShader = /* glsl */ `
    uniform float uOpacity;

    varying vec2 vUv;

    void main() {
      // Bright head on the right, tail fading out to the left, soft across its width.
      float along = pow(vUv.x, 2.5);
      float across = 1.0 - abs(vUv.y - 0.5) * 2.0;
      float alpha = along * across * across * uOpacity;
      gl_FragColor = vec4(vec3(0.9, 0.94, 1.0), alpha);
      #include <colorspace_fragment>
    }
  `;

  const createStarTexture = (CanvasTexture: typeof import("three").CanvasTexture) => {
    const starCanvas = document.createElement("canvas");
    starCanvas.width = 64;
    starCanvas.height = 64;
    const context = starCanvas.getContext("2d");
    if (!context) return null;

    const gradient = context.createRadialGradient(32, 32, 2, 32, 32, 30);
    gradient.addColorStop(0, "rgba(255, 255, 255, 1)");
    gradient.addColorStop(0.35, "rgba(210, 225, 255, 0.92)");
    gradient.addColorStop(0.7, "rgba(170, 195, 255, 0.45)");
    gradient.addColorStop(1, "rgba(170, 195, 255, 0)");

    context.fillStyle = gradient;
    context.beginPath();
    context.arc(32, 32, 30, 0, Math.PI * 2);
    context.fill();

    return new CanvasTexture(starCanvas);
  };

  const mount = async (root: HTMLElement, canvas: HTMLCanvasElement) => {
    const {
      AdditiveBlending,
      BufferAttribute,
      BufferGeometry,
      CanvasTexture,
      Color,
      Mesh,
      PerspectiveCamera,
      PlaneGeometry,
      Points,
      Scene,
      ShaderMaterial,
      Timer,
      Vector3,
      WebGLRenderer,
    } = await import("three");

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mobile = window.matchMedia("(max-width: 768px)").matches;
    const pixelRatio = Math.min(window.devicePixelRatio || 1, mobile ? 1.2 : 1.5);

    let renderer: InstanceType<typeof WebGLRenderer>;
    try {
      renderer = new WebGLRenderer({ canvas, antialias: !mobile, alpha: false });
    } catch (error) {
      console.warn("WebGL renderer could not be created", error);
      return;
    }
    renderer.setPixelRatio(pixelRatio);
    renderer.setClearColor(0x05070f, 1);

    const scene = new Scene();
    const camera = new PerspectiveCamera(58, 1, 0.1, 700);
    camera.position.set(0, 0, 10);

    const starCount = mobile ? 1400 : 2800;
    const fieldWidth = 170;
    const fieldHeight = 150;
    const fieldDepth = 320;
    const near = 8;

    const positions = new Float32Array(starCount * 3);
    const speeds = new Float32Array(starCount);

    for (let i = 0; i < starCount; i += 1) {
      positions[i * 3] = (Math.random() - 0.5) * fieldWidth;
      positions[i * 3 + 1] = (Math.random() - 0.5) * fieldHeight;
      positions[i * 3 + 2] = Math.random() * (fieldDepth + near);
      speeds[i] = mobile ? 3.6 + Math.random() * 5.4 : 5 + Math.random() * 8;
    }

    const geometry = new BufferGeometry();
    geometry.setAttribute("position", new BufferAttribute(positions, 3));
    geometry.setAttribute("aSpeed", new BufferAttribute(speeds, 1));
    // Positions are displaced in the shader, so the CPU-side bounds would be wrong.
    geometry.boundingSphere = null;

    const starTexture = createStarTexture(CanvasTexture);
    if (!starTexture) {
      renderer.dispose();
      return;
    }

    const uniforms = {
      uTravel: { value: 0 },
      uDepth: { value: fieldDepth },
      uNear: { value: near },
      uSize: { value: mobile ? 0.24 : 0.31 },
      uScale: { value: 1 },
      uMap: { value: starTexture },
      uColor: { value: new Color(0xe6efff) },
    };

    const material = new ShaderMaterial({
      uniforms,
      vertexShader,
      fragmentShader,
      transparent: true,
      depthWrite: false,
    });

    // A distant planet behind the star field, lit from the upper left.
    const planetDistance = fieldDepth + 40;
    const planetExtent = 1.25; // quad size relative to the planet radius, leaves room for the glow
    const planetGeometry = new PlaneGeometry(2 * planetExtent, 2 * planetExtent);
    const planetMaterial = new ShaderMaterial({
      uniforms: {
        uExtent: { value: planetExtent },
        uRotation: { value: 0 },
        uLightDirection: { value: new Vector3(-0.65, 0.55, 0.5) },
      },
      vertexShader: planetVertexShader,
      fragmentShader: planetFragmentShader,
      transparent: true,
      depthWrite: false,
    });
    const planet = new Mesh(planetGeometry, planetMaterial);
    planet.renderOrder = -1;
    scene.add(planet);

    const stars = new Points(geometry, material);
    stars.frustumCulled = false;
    scene.add(stars);

    // A single reusable shooting star that shows up every now and then.
    const shootingStarMaterial = new ShaderMaterial({
      uniforms: { uOpacity: { value: 0 } },
      vertexShader: shootingStarVertexShader,
      fragmentShader: shootingStarFragmentShader,
      transparent: true,
      depthWrite: false,
      blending: AdditiveBlending,
    });
    const shootingStarGeometry = new PlaneGeometry(1, 1);
    shootingStarGeometry.translate(-0.5, 0, 0); // origin at the head
    const shootingStar = new Mesh(shootingStarGeometry, shootingStarMaterial);
    shootingStar.visible = false;
    scene.add(shootingStar);

    const shootingStarDepth = 120;
    const shot = { start: 0, duration: 0, from: new Vector3(), direction: new Vector3(), speed: 0, length: 0 };
    let nextShot = 4 + Math.random() * 4;
    const view = { halfWidth: 1, halfHeight: 1 };

    const spawnShootingStar = (now: number) => {
      const halfHeight = Math.tan((camera.fov * Math.PI) / 360) * (shootingStarDepth + camera.position.z);
      const halfWidth = halfHeight * camera.aspect;
      const goingLeft = Math.random() < 0.5;
      const angle = (0.35 + Math.random() * 0.25) * (goingLeft ? 1 : -1);
      shot.from.set(
        (goingLeft ? 0.2 + Math.random() * 0.6 : -0.8 + Math.random() * 0.6) * halfWidth,
        (0.3 + Math.random() * 0.55) * halfHeight,
        -shootingStarDepth,
      );
      shot.direction.set(goingLeft ? -Math.cos(angle) : Math.cos(angle), -Math.abs(Math.sin(angle)), 0);
      shot.speed = halfWidth * (0.9 + Math.random() * 0.5);
      shot.length = halfWidth * (0.12 + Math.random() * 0.08);
      shot.duration = 0.9 + Math.random() * 0.4;
      shot.start = now;
      shootingStar.rotation.z = Math.atan2(shot.direction.y, shot.direction.x);
      shootingStar.visible = true;
    };

    const updateShootingStar = (now: number) => {
      if (!shootingStar.visible) {
        if (now >= nextShot) spawnShootingStar(now);
        return;
      }
      const t = (now - shot.start) / shot.duration;
      if (t >= 1) {
        shootingStar.visible = false;
        nextShot = now + 10 + Math.random() * 10;
        return;
      }
      const travelled = shot.speed * shot.duration * t;
      shootingStar.position.copy(shot.from).addScaledVector(shot.direction, travelled);
      // The tail grows quickly, then the whole streak fades out.
      shootingStar.scale.set(shot.length * Math.min(t * 4, 1), 0.3, 1);
      shootingStarMaterial.uniforms.uOpacity.value = Math.sin(Math.PI * Math.min(t * 1.4, 1));
    };

    // Keeps the planet half cut off in the lower right corner, whatever the viewport.
    let scrollProgress = 0;
    const placePlanet = () => {
      const { halfWidth, halfHeight } = view;
      const radius = Math.min(halfHeight * 0.32, halfWidth * 0.45);
      planet.scale.setScalar(radius);
      planet.position.set(
        halfWidth - radius * 0.75,
        -halfHeight + radius * 0.8 + scrollProgress * halfHeight * 0.3,
        -planetDistance,
      );
    };

    const render = () => renderer.render(scene, camera);

    const resize = () => {
      const { clientWidth, clientHeight } = root;
      if (!clientWidth || !clientHeight) return;
      renderer.setSize(clientWidth, clientHeight, false);
      camera.aspect = clientWidth / clientHeight;
      camera.updateProjectionMatrix();
      uniforms.uScale.value = (clientHeight * pixelRatio) / 2;
      view.halfHeight = Math.tan((camera.fov * Math.PI) / 360) * (planetDistance + camera.position.z);
      view.halfWidth = view.halfHeight * camera.aspect;
      placePlanet();
      if (reducedMotion) render();
    };

    const pointer = { x: 0, y: 0 };
    const look = { x: 0, y: 0 };
    let warp = 0;
    let lastScrollY = window.scrollY;

    const onPointerMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse") return;
      pointer.x = (event.clientX / window.innerWidth) * 2 - 1;
      pointer.y = (event.clientY / window.innerHeight) * 2 - 1;
    };

    const timer = new Timer();
    let raf = 0;
    let running = false;

    const tick = (time: DOMHighResTimeStamp) => {
      timer.update(time);
      const dt = Math.min(timer.getDelta(), 1 / 30);
      const elapsed = timer.getElapsed();

      // Scrolling briefly speeds up the flight ("warp"), then eases back.
      const scrollDelta = Math.abs(window.scrollY - lastScrollY);
      lastScrollY = window.scrollY;
      const warpTarget = Math.min(scrollDelta / Math.max(dt, 1e-3) / 350, 5);
      warp += (warpTarget - warp) * (1 - Math.exp(-dt * (warpTarget > warp ? 6 : 2)));

      uniforms.uTravel.value += dt * (1 + warp);

      // The planet turns very slowly and rises a little while scrolling down the page.
      planetMaterial.uniforms.uRotation.value += dt * 0.02;
      const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      scrollProgress += (Math.min(window.scrollY / maxScroll, 1) - scrollProgress) * (1 - Math.exp(-dt * 3));
      placePlanet();

      updateShootingStar(elapsed);

      // Slow idle drift plus a subtle parallax towards the mouse.
      const ease = 1 - Math.exp(-dt * 2.5);
      look.x += (pointer.x - look.x) * ease;
      look.y += (pointer.y - look.y) * ease;
      camera.position.x = Math.sin(elapsed * 0.14) * 0.12 + look.x * 0.9;
      camera.position.y = Math.sin(elapsed * 0.11) * 0.08 - look.y * 0.6;
      camera.lookAt(camera.position.x * 0.4, camera.position.y * 0.4, -40);

      render();
      raf = window.requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || reducedMotion) return;
      running = true;
      timer.reset();
      lastScrollY = window.scrollY;
      raf = window.requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      window.cancelAnimationFrame(raf);
    };

    const onVisibilityChange = () => (document.hidden ? stop() : start());
    const onPageShow = (event: PageTransitionEvent) => event.persisted && start();

    const onPageHide = (event: PageTransitionEvent) => {
      stop();
      // Pages kept in the back/forward cache come back via "pageshow" and must stay intact.
      if (event.persisted) return;
      document.removeEventListener("visibilitychange", onVisibilityChange);
      window.removeEventListener("resize", resize);
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("pageshow", onPageShow);
      window.removeEventListener("pagehide", onPageHide);
      geometry.dispose();
      material.dispose();
      starTexture.dispose();
      planetGeometry.dispose();
      planetMaterial.dispose();
      shootingStarGeometry.dispose();
      shootingStarMaterial.dispose();
      renderer.dispose();
    };

    resize();
    camera.lookAt(0, 0, -40);
    if (reducedMotion) {
      // Show a still star field instead of an animation.
      uniforms.uTravel.value = 12;
      render();
    } else {
      start();
    }

    document.addEventListener("visibilitychange", onVisibilityChange);
    window.addEventListener("resize", resize, { passive: true });
    window.addEventListener("pointermove", onPointerMove, { passive: true });
    window.addEventListener("pageshow", onPageShow);
    window.addEventListener("pagehide", onPageHide);
  };

  const root = document.querySelector<HTMLElement>(".hero-3d-bg");
  const canvas = root?.querySelector<HTMLCanvasElement>(".hero-3d-canvas");

  if (root && canvas) {
    // Load three.js once the page itself is ready, so it never competes with content.
    const load = () => mount(root, canvas);
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(load, { timeout: 1500 });
    } else {
      setTimeout(load, 200);
    }
  }
</script>

<style>
  .hero-3d-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .hero-3d-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-3d-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(5, 7, 15, 0.06);
    background-image:
      radial-gradient(circle at 50% 8%, rgba(59, 130, 246, 0.18), transparent 44%),
      radial-gradient(circle at 85% 15%, rgba(168, 85, 247, 0.1), transparent 38%);
  }
</style>
