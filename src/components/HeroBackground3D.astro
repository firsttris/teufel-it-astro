<div class="hero-3d-bg" aria-hidden="true">
  <canvas class="hero-3d-canvas"></canvas>
  <div class="hero-3d-overlay"></div>
</div>

<script>
  const vertexShader = /* glsl */ `
    attribute float aSpeed;

    uniform float uTravel;
    uniform float uDepth;
    uniform float uNear;
    uniform float uSize;
    uniform float uScale;

    varying float vFade;

    void main() {
      // Stars move along +z and wrap around, so the whole flight happens on the GPU.
      float span = uDepth + uNear;
      float z = mod(position.z + uTravel * aSpeed, span) - uDepth;

      vec4 mvPosition = modelViewMatrix * vec4(position.xy, z, 1.0);
      gl_Position = projectionMatrix * mvPosition;
      gl_PointSize = uSize * uScale / -mvPosition.z;

      // Fade stars in at the far end and out right before they pass the camera.
      vFade = smoothstep(-uDepth, -uDepth + 60.0, z) * (1.0 - smoothstep(uNear - 4.0, uNear, z));
    }
  `;

  const fragmentShader = /* glsl */ `
    uniform sampler2D uMap;
    uniform vec3 uColor;

    varying float vFade;

    void main() {
      vec4 texel = texture2D(uMap, gl_PointCoord);
      float alpha = texel.a * vFade;
      if (alpha < 0.08) discard;
      gl_FragColor = vec4(uColor * texel.rgb, alpha);
      #include <colorspace_fragment>
    }
  `;

  const createStarTexture = (CanvasTexture: typeof import("three").CanvasTexture) => {
    const starCanvas = document.createElement("canvas");
    starCanvas.width = 64;
    starCanvas.height = 64;
    const context = starCanvas.getContext("2d");
    if (!context) return null;

    const gradient = context.createRadialGradient(32, 32, 2, 32, 32, 30);
    gradient.addColorStop(0, "rgba(255, 255, 255, 1)");
    gradient.addColorStop(0.35, "rgba(210, 225, 255, 0.92)");
    gradient.addColorStop(0.7, "rgba(170, 195, 255, 0.45)");
    gradient.addColorStop(1, "rgba(170, 195, 255, 0)");

    context.fillStyle = gradient;
    context.beginPath();
    context.arc(32, 32, 30, 0, Math.PI * 2);
    context.fill();

    return new CanvasTexture(starCanvas);
  };

  const mount = async (root: HTMLElement, canvas: HTMLCanvasElement) => {
    const {
      BufferAttribute,
      CanvasTexture,
      Color,
      BufferGeometry,
      PerspectiveCamera,
      Points,
      Scene,
      ShaderMaterial,
      Timer,
      WebGLRenderer,
    } = await import("three");

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mobile = window.matchMedia("(max-width: 768px)").matches;
    const pixelRatio = Math.min(window.devicePixelRatio || 1, mobile ? 1.2 : 1.5);

    let renderer: InstanceType<typeof WebGLRenderer>;
    try {
      renderer = new WebGLRenderer({ canvas, antialias: !mobile, alpha: false });
    } catch (error) {
      console.warn("WebGL renderer could not be created", error);
      return;
    }
    renderer.setPixelRatio(pixelRatio);
    renderer.setClearColor(0x05070f, 1);

    const scene = new Scene();
    const camera = new PerspectiveCamera(58, 1, 0.1, 400);
    camera.position.set(0, 0, 10);

    const starCount = mobile ? 1400 : 2800;
    const fieldWidth = 170;
    const fieldHeight = 150;
    const fieldDepth = 320;
    const near = 8;

    const positions = new Float32Array(starCount * 3);
    const speeds = new Float32Array(starCount);

    for (let i = 0; i < starCount; i += 1) {
      positions[i * 3] = (Math.random() - 0.5) * fieldWidth;
      positions[i * 3 + 1] = (Math.random() - 0.5) * fieldHeight;
      positions[i * 3 + 2] = Math.random() * (fieldDepth + near);
      speeds[i] = mobile ? 3.6 + Math.random() * 5.4 : 5 + Math.random() * 8;
    }

    const geometry = new BufferGeometry();
    geometry.setAttribute("position", new BufferAttribute(positions, 3));
    geometry.setAttribute("aSpeed", new BufferAttribute(speeds, 1));
    // Positions are displaced in the shader, so the CPU-side bounds would be wrong.
    geometry.boundingSphere = null;

    const starTexture = createStarTexture(CanvasTexture);
    if (!starTexture) {
      renderer.dispose();
      return;
    }

    const uniforms = {
      uTravel: { value: 0 },
      uDepth: { value: fieldDepth },
      uNear: { value: near },
      uSize: { value: mobile ? 0.24 : 0.31 },
      uScale: { value: 1 },
      uMap: { value: starTexture },
      uColor: { value: new Color(0xe6efff) },
    };

    const material = new ShaderMaterial({
      uniforms,
      vertexShader,
      fragmentShader,
      transparent: true,
      depthWrite: false,
    });

    const stars = new Points(geometry, material);
    stars.frustumCulled = false;
    scene.add(stars);

    const render = () => renderer.render(scene, camera);

    const resize = () => {
      const { clientWidth, clientHeight } = root;
      if (!clientWidth || !clientHeight) return;
      renderer.setSize(clientWidth, clientHeight, false);
      camera.aspect = clientWidth / clientHeight;
      camera.updateProjectionMatrix();
      uniforms.uScale.value = (clientHeight * pixelRatio) / 2;
      if (reducedMotion) render();
    };

    const pointer = { x: 0, y: 0 };
    const look = { x: 0, y: 0 };
    let warp = 0;
    let lastScrollY = window.scrollY;

    const onPointerMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse") return;
      pointer.x = (event.clientX / window.innerWidth) * 2 - 1;
      pointer.y = (event.clientY / window.innerHeight) * 2 - 1;
    };

    const timer = new Timer();
    let raf = 0;
    let running = false;

    const tick = (time: DOMHighResTimeStamp) => {
      timer.update(time);
      const dt = Math.min(timer.getDelta(), 1 / 30);
      const elapsed = timer.getElapsed();

      // Scrolling briefly speeds up the flight ("warp"), then eases back.
      const scrollDelta = Math.abs(window.scrollY - lastScrollY);
      lastScrollY = window.scrollY;
      const warpTarget = Math.min(scrollDelta / Math.max(dt, 1e-3) / 350, 5);
      warp += (warpTarget - warp) * (1 - Math.exp(-dt * (warpTarget > warp ? 6 : 2)));

      uniforms.uTravel.value += dt * (1 + warp);

      // Slow idle drift plus a subtle parallax towards the mouse.
      const ease = 1 - Math.exp(-dt * 2.5);
      look.x += (pointer.x - look.x) * ease;
      look.y += (pointer.y - look.y) * ease;
      camera.position.x = Math.sin(elapsed * 0.14) * 0.12 + look.x * 0.9;
      camera.position.y = Math.sin(elapsed * 0.11) * 0.08 - look.y * 0.6;
      camera.lookAt(camera.position.x * 0.4, camera.position.y * 0.4, -40);

      render();
      raf = window.requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || reducedMotion) return;
      running = true;
      timer.reset();
      lastScrollY = window.scrollY;
      raf = window.requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      window.cancelAnimationFrame(raf);
    };

    const onVisibilityChange = () => (document.hidden ? stop() : start());
    const onPageShow = (event: PageTransitionEvent) => event.persisted && start();

    const onPageHide = (event: PageTransitionEvent) => {
      stop();
      // Pages kept in the back/forward cache come back via "pageshow" and must stay intact.
      if (event.persisted) return;
      document.removeEventListener("visibilitychange", onVisibilityChange);
      window.removeEventListener("resize", resize);
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("pageshow", onPageShow);
      window.removeEventListener("pagehide", onPageHide);
      geometry.dispose();
      material.dispose();
      starTexture.dispose();
      renderer.dispose();
    };

    resize();
    camera.lookAt(0, 0, -40);
    if (reducedMotion) {
      // Show a still star field instead of an animation.
      uniforms.uTravel.value = 12;
      render();
    } else {
      start();
    }

    document.addEventListener("visibilitychange", onVisibilityChange);
    window.addEventListener("resize", resize, { passive: true });
    window.addEventListener("pointermove", onPointerMove, { passive: true });
    window.addEventListener("pageshow", onPageShow);
    window.addEventListener("pagehide", onPageHide);
  };

  const root = document.querySelector<HTMLElement>(".hero-3d-bg");
  const canvas = root?.querySelector<HTMLCanvasElement>(".hero-3d-canvas");

  if (root && canvas) {
    // Load three.js once the page itself is ready, so it never competes with content.
    const load = () => mount(root, canvas);
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(load, { timeout: 1500 });
    } else {
      setTimeout(load, 200);
    }
  }
</script>

<style>
  .hero-3d-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .hero-3d-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-3d-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(5, 7, 15, 0.06);
    background-image:
      radial-gradient(circle at 50% 8%, rgba(59, 130, 246, 0.18), transparent 44%),
      radial-gradient(circle at 85% 15%, rgba(168, 85, 247, 0.1), transparent 38%);
  }
</style>
