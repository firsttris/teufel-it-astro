---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const installs = `${new Intl.NumberFormat(lang === "de" ? "de-DE" : "en-US").format(2_000_000)}+`;

const cards = [
  {
    value: installs,
    label: t("impact.installs.label"),
    gradient: "from-blue-400 to-cyan-400",
    key: "impact.installs.desc",
    placeholder: "vscodeJestRunner",
    href: "https://marketplace.visualstudio.com/items?itemName=firsttris.vscode-jest-runner",
    linkText: "vscode-jest-runner",
  },
  {
    value: t("impact.nx.value"),
    label: t("impact.nx.label"),
    gradient: "from-purple-400 to-pink-400",
    key: "impact.nx.desc",
    placeholder: "nx",
    href: "https://github.com/nrwl/nx/issues/3868",
    linkText: "Nx",
  },
] as const;
---

<section class="relative py-24">
  <div class="container mx-auto px-6 text-center md:px-12">
    <div class="mx-auto max-w-4xl space-y-12">
      <div class="space-y-4">
        <h2 class="text-2xl font-bold text-white md:text-4xl">{t("impact.title")}</h2>
        <div class="mx-auto h-1 w-20 rounded-full bg-blue-500"></div>
      </div>

      <div class="grid items-stretch gap-8 md:grid-cols-2">
        {
          cards.map((card) => (
            <div class="flex h-full flex-col rounded-2xl border border-white/10 bg-zinc-900/30 p-8 backdrop-blur-sm transition-colors duration-300 hover:border-blue-500/50">
              <div
                class:list={[
                  "mb-2 bg-linear-to-r bg-clip-text text-3xl font-black text-balance text-transparent lg:text-4xl",
                  card.gradient,
                ]}
              >
                {card.value}
              </div>
              <div class="text-sm font-medium tracking-wider text-zinc-500 uppercase">{card.label}</div>
              <p class="mt-4 leading-relaxed text-zinc-300">
                {t.rich(card.key, {
                  [card.placeholder]: (
                    <a
                      href={card.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-semibold text-white underline decoration-blue-500/50 transition-colors hover:decoration-blue-500"
                    >
                      {card.linkText}
                    </a>
                  ),
                })}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
