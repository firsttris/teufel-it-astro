// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what the website builds on, plus the "Dependency Dashboard" issue listing what is open. Their own
// pull requests: Astro with astro-icon and the withastro/action that builds and uploads the site,
// Tailwind CSS and Bun (packageManager in package.json), which also runs Astro.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  // Its pull requests run no CI, so nothing merges itself
  automerge: false,
  lockFileMaintenance: { automerge: false },
  customManagers: [
    {
      // The Astro major of the README (badge and the stack list)
      customType: "regex",
      managerFilePatterns: ["/^README\\.md$/"],
      matchStrings: ["badge/astro-(?<currentValue>\\d+)-", "\\[Astro\\]\\(https://astro\\.build/\\) (?<currentValue>\\d+)\\n"],
      depNameTemplate: "astro-readme",
      packageNameTemplate: "astro",
      datasourceTemplate: "npm",
      extractVersionTemplate: "^(?<version>\\d+)\\.\\d+\\.\\d+$",
      versioningTemplate: "regex:^(?<major>\\d+)$",
    },
    {
      // The Tailwind major of the README (badge, features, stack list)
      customType: "regex",
      managerFilePatterns: ["/^README\\.md$/"],
      matchStrings: [
        "badge/tailwindcss-(?<currentValue>\\d+)-",
        "Styling mit Tailwind CSS (?<currentValue>\\d+)\\n",
        "\\[Tailwind CSS\\]\\(https://tailwindcss\\.com/\\) (?<currentValue>\\d+)\\n",
      ],
      depNameTemplate: "tailwindcss-readme",
      packageNameTemplate: "tailwindcss",
      datasourceTemplate: "npm",
      extractVersionTemplate: "^(?<version>\\d+)\\.\\d+\\.\\d+$",
      versioningTemplate: "regex:^(?<major>\\d+)$",
    },
  ],
  packageRules: [
    {
      // Astro, astro-icon and withastro/action in one PR: a new Astro major usually needs a new
      // astro-icon and a newer action (its package manager detection and setup)
      matchPackageNames: ["astro", "@astrojs/**", "astro-icon", "withastro/action"],
      enabled: true,
      groupName: "Astro",
      sourceUrl: "https://github.com/withastro/astro",
      prBodyNotes: [
        "Before merging: read the Astro upgrade guide for a new major (https://docs.astro.build/en/upgrade-astro/) and whether it still runs on Bun (the scripts run `bun --bun astro`). The Check Build run of this PR builds the site; locally `bun run build` and look at the pages at 390, 1024 and 1440 px width (CLAUDE.md), German and English.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["tailwindcss", "@tailwindcss/**"],
      enabled: true,
      groupName: "Tailwind CSS",
      sourceUrl: "https://github.com/tailwindlabs/tailwindcss",
      prBodyNotes: [
        "Before merging: `bun run build` and look at the pages at 390, 1024 and 1440 px width (CLAUDE.md). A new major: read the upgrade guide (https://tailwindcss.com/docs/upgrade-guide).",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // packageManager in package.json (Renovate reads it as the dependency `bun`): the Bun that
      // withastro/action sets up in both workflows (package-manager, read from package.json)
      matchPackageNames: ["bun"],
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "`packageManager` in package.json is the Bun of the Check Build and Deploy workflows (withastro/action's `package-manager`, read from package.json). Bun installs the packages (`bun.lock`, the workflows fail if `bun install` had to change it) and runs Astro (`bun --bun astro`). The Check Build run of this PR builds the site; locally `bun install && bun run build`.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
  ],
}
